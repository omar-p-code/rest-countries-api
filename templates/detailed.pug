extends ./index.pug
block basic
   - var page = 'details'
block content
   .back &larr; Back
   .details
      .image
         img(loading='lazy')
      .info
         .name
         .country-info
            .country-details
               .native-name
               .population
               .region
               .sub-region
               .capital
            .country-meta
               .top-level-domain
               .currencies
               .languages
         .country-borders
            span Borders Countries:
            .borders
